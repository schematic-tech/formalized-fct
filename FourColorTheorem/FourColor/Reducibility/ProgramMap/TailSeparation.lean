import FourColorTheorem.FourColor.Reducibility.ProgramMap.MaskAdjacency

namespace Schematic.Math.GraphTheory
namespace FourColor
namespace PointedHypermap

/-- Tail face-separation invariant for the Y/H construction steps.

The ring clauses start at the first old ring entries used by the fresh-point
cases, and the kernel clauses cover every semantic kernel dart.
This is deliberately separate from `cpMaskAdjInvariant`: ring cyclicity alone
does not imply these face-separation facts. -/
structure cpTailSeparation (cp : CProg) : Prop where
  ringPoint :
    ∀ x : (cpmap cp).map.Dart,
      x ∈ (cpRing cp).drop 2 →
        ¬ PermReachable (cpmap cp).map.face (cpmap cp).point x
  ringNode :
    ∀ x : (cpmap cp).map.Dart,
      x ∈ (cpRing cp).drop 2 →
        ¬ PermReachable (cpmap cp).map.face
          ((cpmap cp).map.node (cpmap cp).point) x
  ringFaceEdge :
    ∀ x : (cpmap cp).map.Dart,
      x ∈ (cpRing cp).drop 3 →
        ¬ PermReachable (cpmap cp).map.face
          ((cpmap cp).map.face ((cpmap cp).map.edge (cpmap cp).point)) x
  kernelPoint :
    ∀ x : (cpmap cp).map.Dart,
      x ∈ cpKernel cp →
        ¬ PermReachable (cpmap cp).map.face (cpmap cp).point x
  kernelNode :
    ∀ x : (cpmap cp).map.Dart,
      x ∈ cpKernel cp →
        ¬ PermReachable (cpmap cp).map.face
          ((cpmap cp).map.node (cpmap cp).point) x
  kernelFaceEdge :
    ∀ x : (cpmap cp).map.Dart,
      x ∈ cpKernel cp →
        ¬ PermReachable (cpmap cp).map.face
          ((cpmap cp).map.face ((cpmap cp).map.edge (cpmap cp).point)) x

/-- Coq `cpmap_simple` target: the configuration ring followed by the
semantic kernel is face-simple. -/
def cpMapSimple (cp : CProg) : Prop :=
  (cpmap cp).map.FaceSimple (cpRing cp ++ cpKernel cp)

/-- Coq `cpmap_cover` target: every dart of the constructed map lies in the
face band generated by the configuration ring followed by the semantic
kernel. -/
def cpMapCover (cp : CProg) : Prop :=
  ∀ x : (cpmap cp).map.Dart,
    (cpmap cp).map.FaceBand (cpRing cp ++ cpKernel cp) x

/-- Coq's `kernel (cpring G) =i fband (cpker cp)`, expressed using the
semantic ring and kernel lists.  Face-simplicity makes the two bands
disjoint, while `cpMapCover` says that they exhaust the map. -/
theorem cpKernel_faceBand_iff_not_cpRing_faceBand
    {cp : CProg}
    (hsimple : cpMapSimple cp)
    (hcover : cpMapCover cp)
    (x : (cpmap cp).map.Dart) :
    (cpmap cp).map.FaceBand (cpKernel cp) x ↔
      ¬ (cpmap cp).map.FaceBand (cpRing cp) x := by
  let G := (cpmap cp).map
  have hsimple' : G.FaceSimple (cpRing cp ++ cpKernel cp) := hsimple
  constructor
  · rintro ⟨k, hk, hkx⟩ ⟨r, hr, hrx⟩
    have hrk : PermReachable G.face r k :=
      PermReachable.trans G.face hrx (PermReachable.symm G.face hkx)
    have hrEqK : r = k :=
      Hypermap.FaceSimple.eq_of_faceReachable_of_mem
        (G := G) hsimple'
        (List.mem_append.mpr (Or.inl hr))
        (List.mem_append.mpr (Or.inr hk)) hrk
    have hdisjoint : (cpRing cp).Disjoint (cpKernel cp) :=
      List.disjoint_of_nodup_append hsimple'.nodup
    exact hdisjoint hr (hrEqK ▸ hk)
  · intro hnotRing
    rcases hcover x with ⟨y, hy, hyx⟩
    rcases List.mem_append.mp hy with hyRing | hyKernel
    · exact False.elim
        (hnotRing ⟨y, hyRing, hyx⟩)
    · exact ⟨y, hyKernel, hyx⟩

theorem cpTailSeparation.ringPoint_of_mem_drop_three
    {cp : CProg} (hsep : cpTailSeparation cp)
    {x : (cpmap cp).map.Dart}
    (hx : x ∈ (cpRing cp).drop 3) :
    ¬ PermReachable (cpmap cp).map.face (cpmap cp).point x := by
  apply hsep.ringPoint x
  have hx' : x ∈ ((cpRing cp).drop 2).drop 1 := by
    simpa [List.drop_drop] using hx
  exact (List.drop_subset 1 ((cpRing cp).drop 2)) hx'

theorem cpTailSeparation.ringNode_of_mem_drop_three
    {cp : CProg} (hsep : cpTailSeparation cp)
    {x : (cpmap cp).map.Dart}
    (hx : x ∈ (cpRing cp).drop 3) :
    ¬ PermReachable (cpmap cp).map.face
      ((cpmap cp).map.node (cpmap cp).point) x := by
  apply hsep.ringNode x
  have hx' : x ∈ ((cpRing cp).drop 2).drop 1 := by
    simpa [List.drop_drop] using hx
  exact (List.drop_subset 1 ((cpRing cp).drop 2)) hx'

theorem cpTailSeparation_of_cpMapSimple
    {cp : CProg}
    (hsize : 2 < CProg.ringSize cp)
    (hsimple : cpMapSimple cp) :
    cpTailSeparation cp := by
  let P := cpmap cp
  let faceEdge := P.map.face (P.map.edge P.point)
  have hring :
      cpRing cp =
        P.map.node P.point :: P.point :: faceEdge :: (cpRing cp).drop 3 := by
    simpa [P, faceEdge] using
      cpRing_eq_nodePoint_point_faceEdge_cons_drop_three_of_ringSize_gt_two
        (cp := cp) hsize
  have hdrop2 :
      (cpRing cp).drop 2 = faceEdge :: (cpRing cp).drop 3 := by
    simpa [P, faceEdge] using
      cpRing_drop_two_eq_faceEdge_cons_drop_three_of_ringSize_gt_two
        (cp := cp) hsize
  have hfull :
      P.map.FaceSimple
        (P.map.node P.point :: P.point :: faceEdge ::
          ((cpRing cp).drop 3 ++ cpKernel cp)) := by
    have hsimple' : P.map.FaceSimple (cpRing cp ++ cpKernel cp) := by
      simpa [cpMapSimple, P] using hsimple
    rw [hring] at hsimple'
    simpa only [List.cons_append] using hsimple'
  have hnode :
      ∀ y,
        y ∈ P.point :: faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp) →
          ¬ PermReachable P.map.face (P.map.node P.point) y :=
    (List.pairwise_cons.mp hfull).1
  have htail1 :
      P.map.FaceSimple
        (P.point :: faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp)) :=
    (List.pairwise_cons.mp hfull).2
  have hpoint :
      ∀ y,
        y ∈ faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp) →
          ¬ PermReachable P.map.face P.point y :=
    (List.pairwise_cons.mp htail1).1
  have htail2 :
      P.map.FaceSimple
        (faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp)) :=
    (List.pairwise_cons.mp htail1).2
  have hfaceEdge :
      ∀ y,
        y ∈ (cpRing cp).drop 3 ++ cpKernel cp →
          ¬ PermReachable P.map.face faceEdge y :=
    (List.pairwise_cons.mp htail2).1
  refine
    { ringPoint := ?_
      ringNode := ?_
      ringFaceEdge := ?_
      kernelPoint := ?_
      kernelNode := ?_
      kernelFaceEdge := ?_ }
  · intro x hx hreach
    have hxTail : x ∈ faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp) := by
      rw [hdrop2] at hx
      rcases List.mem_cons.mp hx with rfl | hx3
      · simp
      · simp [List.mem_append, hx3]
    exact hpoint x hxTail hreach
  · intro x hx hreach
    have hxTail :
        x ∈ P.point :: faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp) := by
      rw [hdrop2] at hx
      rcases List.mem_cons.mp hx with rfl | hx3
      · simp
      · simp [List.mem_append, hx3]
    exact hnode x hxTail hreach
  · intro x hx hreach
    exact hfaceEdge x (by simp [List.mem_append, hx]) hreach
  · intro x hx hreach
    have hxTail : x ∈ faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp) := by
      simp [List.mem_append, hx]
    exact hpoint x hxTail hreach
  · intro x hx hreach
    have hxTail :
        x ∈ P.point :: faceEdge :: ((cpRing cp).drop 3 ++ cpKernel cp) := by
      simp [List.mem_append, hx]
    exact hnode x hxTail hreach
  · intro x hx hreach
    exact hfaceEdge x (by simp [List.mem_append, hx]) hreach

theorem cpTailSeparation_of_cpMapSimple_config
    {cp : CProg}
    (hcfg : CProg.config cp = true)
    (hsimple : cpMapSimple cp) :
    cpTailSeparation cp :=
  cpTailSeparation_of_cpMapSimple
    (CProg.ringSize_gt_two_of_config hcfg) hsimple

theorem cpMaskAdjInvariant_y_of_tailSeparation
    {cp : CProg}
    (h : cpMaskAdjInvariant cp)
    (hproper : (cpmap cp).ProperRingHead)
    (hplainY : ((cpmap cp).y).map.Plain)
    (hbridgeY : ((cpmap cp).y).map.Bridgeless)
    (hsize : 1 < CProg.ringSize cp)
    (hsep : cpTailSeparation cp) :
    cpMaskAdjInvariant (CpStep.y :: cp) :=
  cpMaskAdjInvariant_y_of_tail_reach_avoids
    h hproper hplainY hbridgeY hsize
    hsep.ringPoint hsep.ringNode hsep.kernelPoint hsep.kernelNode

theorem cpMaskAdjInvariant_h_of_tailSeparation
    {cp : CProg}
    (h : cpMaskAdjInvariant cp)
    (hproper : (cpmap cp).ProperRingHead)
    (hlong : (cpmap cp).LongRingHead)
    (hplainH : ((cpmap cp).h).map.Plain)
    (hbridgeH : ((cpmap cp).h).map.Bridgeless)
    (hsize : 2 < CProg.ringSize cp)
    (hsep : cpTailSeparation cp) :
    cpMaskAdjInvariant (CpStep.h :: cp) :=
  cpMaskAdjInvariant_h_of_tail_reach_avoids
    h hproper hlong hplainH hbridgeH hsize
    hsep.ringFaceEdge
    (fun _x hx => hsep.ringPoint_of_mem_drop_three hx)
    (fun _x hx => hsep.ringNode_of_mem_drop_three hx)
    hsep.kernelFaceEdge hsep.kernelPoint hsep.kernelNode

theorem cpMask_cfmask1_getElem?_of_config
    {cp : CProg} {i : Nat}
    (hcfg : CProg.config cp = true) :
    cpMask (CfMask.cfmask1 cp i) cp =
      match (cpKernel cp)[i]? with
      | some x => [x]
      | none => [] := by
  unfold cpMask
  have h :=
    CfMask.cpmask1_getElem?_of_kernel_length
    (α := (cpmap cp).map.Dart)
    cp i (cpRing cp) (cpKernel cp)
    (length_cpKernel_of_config cp hcfg)
  cases hget : (cpKernel cp)[i]? with
  | none =>
      simpa [hget] using h
  | some x =>
      simpa [hget] using h

theorem cpMask_cfmask1_eq_singleton_of_config
    {cp : CProg} {i : Nat}
    (hcfg : CProg.config cp = true)
    (hi : i < CProg.kernelSize cp) :
    cpMask (CfMask.cfmask1 cp i) cp =
      [(cpKernel cp).get
        ⟨i, by
          rw [length_cpKernel_of_config cp hcfg]
          exact hi⟩] := by
  have hlen : i < (cpKernel cp).length := by
    rw [length_cpKernel_of_config cp hcfg]
    exact hi
  rw [cpMask_cfmask1_getElem?_of_config (cp := cp) (i := i) hcfg]
  simp [List.getElem?_eq_getElem hlen]

