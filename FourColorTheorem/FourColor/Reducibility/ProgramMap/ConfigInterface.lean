import FourColorTheorem.FourColor.Reducibility.ProgramMap.Configuration.MaskSoundness

namespace Schematic.Math.GraphTheory
namespace FourColor
namespace Config

/-- Total semantic interpretation of a parsed configuration descriptor. -/
noncomputable def map (cf : Config) : PointedHypermap :=
  PointedHypermap.cpmap cf.program

/-- Semantic ring representatives of a configuration map. -/
noncomputable def ringDarts (cf : Config) : List cf.map.map.Dart :=
  PointedHypermap.cpRing cf.program

/-- Coq `cfring`: the configuration boundary in the orientation used by
`C_reducible`.  The executable contraction theorem reads colors on its
reverse, which is the construction-order list `ringDarts`. -/
noncomputable def reducibilityRingDarts (cf : Config) :
    List cf.map.map.Dart :=
  cf.ringDarts.reverse

/-- Semantic kernel representatives of a configuration map. -/
noncomputable def kernelDarts (cf : Config) : List cf.map.map.Dart :=
  PointedHypermap.cpKernel cf.program

/-- Semantic face-mask selection in a configuration map. -/
noncomputable def maskDarts (cf : Config) (m : CfMask) :
    List cf.map.map.Dart :=
  PointedHypermap.cpMask m cf.program

/-- Face band generated by the semantic ring representatives of a
configuration map. -/
noncomputable def ringSet (cf : Config) : cf.map.map.Dart → Prop :=
  cf.map.map.FaceBand cf.ringDarts

/-- Face band generated by the semantic kernel representatives of a
configuration map. -/
noncomputable def kernelSet (cf : Config) : cf.map.map.Dart → Prop :=
  cf.map.map.FaceBand cf.kernelDarts

@[simp]
theorem length_ringDarts (cf : Config) :
    cf.ringDarts.length = CProg.ringSize cf.program := by
  exact PointedHypermap.length_cpRing cf.program

@[simp]
theorem length_reducibilityRingDarts (cf : Config) :
    cf.reducibilityRingDarts.length = CProg.ringSize cf.program := by
  simp [reducibilityRingDarts]

@[simp]
theorem reverse_reducibilityRingDarts (cf : Config) :
    cf.reducibilityRingDarts.reverse = cf.ringDarts := by
  simp [reducibilityRingDarts]

theorem length_kernelDarts_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed) :
    cf.kernelDarts.length = CProg.kernelSize cf.program := by
  simpa [kernelDarts, WellFormed] using
    PointedHypermap.length_cpKernel_of_config cf.program hcf

theorem maskDarts_cfmask1_getElem?_of_wellFormed
    {cf : Config} {i : Nat}
    (hcf : cf.WellFormed) :
    cf.maskDarts (CfMask.cfmask1 cf.program i) =
      match cf.kernelDarts[i]? with
      | some x => [x]
      | none => [] := by
  have h :=
    PointedHypermap.cpMask_cfmask1_getElem?_of_config
      (cp := cf.program) (i := i) hcf
  cases hget : cf.kernelDarts[i]? with
  | none =>
      have hget' :
          (PointedHypermap.cpKernel cf.program)[i]? = none := by
        simpa [kernelDarts] using hget
      simpa [maskDarts, kernelDarts, hget'] using h
  | some x =>
      have hget' :
          (PointedHypermap.cpKernel cf.program)[i]? = some x := by
        simpa [kernelDarts] using hget
      simpa [maskDarts, kernelDarts, hget'] using h

theorem maskDarts_cfmask1_eq_singleton_of_wellFormed
    {cf : Config} {i : Nat}
    (hcf : cf.WellFormed)
    (hi : i < CProg.kernelSize cf.program) :
    cf.maskDarts (CfMask.cfmask1 cf.program i) =
      [cf.kernelDarts.get
        ⟨i, by
          rw [length_kernelDarts_of_wellFormed hcf]
          exact hi⟩] := by
  simpa [maskDarts, kernelDarts, WellFormed] using
    PointedHypermap.cpMask_cfmask1_eq_singleton_of_config
      (cp := cf.program) (i := i) hcf hi

theorem ringSet_of_mem_ringDarts
    {cf : Config} {x : cf.map.map.Dart}
    (hx : x ∈ cf.ringDarts) :
    cf.ringSet x :=
  Hypermap.FaceBand.of_mem (G := cf.map.map) hx
    (PermReachable.refl cf.map.map.face x)

theorem kernelSet_of_mem_kernelDarts
    {cf : Config} {x : cf.map.map.Dart}
    (hx : x ∈ cf.kernelDarts) :
    cf.kernelSet x :=
  Hypermap.FaceBand.of_mem (G := cf.map.map) hx
    (PermReachable.refl cf.map.map.face x)

theorem ringSet_closed
    {cf : Config} {x y : cf.map.map.Dart}
    (hx : cf.ringSet x)
    (hxy : PermReachable cf.map.map.face x y) :
    cf.ringSet y :=
  Hypermap.FaceBand.of_faceReachable (G := cf.map.map) hx hxy

theorem kernelSet_closed
    {cf : Config} {x y : cf.map.map.Dart}
    (hx : cf.kernelSet x)
    (hxy : PermReachable cf.map.map.face x y) :
    cf.kernelSet y :=
  Hypermap.FaceBand.of_faceReachable (G := cf.map.map) hx hxy

