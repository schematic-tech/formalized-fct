theorem map_quasicubic_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed) :
    cf.map.Quasicubic :=
  map_quasicubic_of_cubicProgram (wellFormed_cubicProgram hcf)

theorem kernelSet_not_onRing_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed)
    {x : cf.map.map.Dart}
    (hx : cf.kernelSet x) :
    ¬ cf.map.OnRing x := by
  intro hxRing
  have hcycle :=
    PointedHypermap.cpRingCycle_of_config (cp := cf.program) hcf
  have hxRingDarts : x ∈ cf.ringDarts := by
    simpa [map, ringDarts] using
      hcycle.mem_ringDarts_of_onRing
        (CProg.ringSize_pos cf.program) hxRing
  rcases hx with ⟨k, hkKernel, hkx⟩
  have hsimple :
      cf.map.map.FaceSimple (cf.ringDarts ++ cf.kernelDarts) := by
    simpa [map, ringDarts, kernelDarts,
      PointedHypermap.cpMapSimple] using
      PointedHypermap.cpMapSimple_of_config (cp := cf.program) hcf
  have hxEq : x = k :=
    Hypermap.FaceSimple.eq_of_faceReachable_of_mem
      (G := cf.map.map) hsimple
      (List.mem_append.mpr (Or.inl hxRingDarts))
      (List.mem_append.mpr (Or.inr hkKernel))
      (PermReachable.symm cf.map.map.face hkx)
  have hdisjoint : cf.ringDarts.Disjoint cf.kernelDarts :=
    List.disjoint_of_nodup_append hsimple.nodup
  have hxKernel : x ∈ cf.kernelDarts := by
    rw [hxEq]
    exact hkKernel
  exact hdisjoint hxRingDarts hxKernel

theorem map_cubicOn_kernelSet_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed) :
    cf.map.map.CubicOn cf.kernelSet := by
  intro x hx
  exact map_quasicubic_of_wellFormed hcf x
    (kernelSet_not_onRing_of_wellFormed hcf hx)

theorem map_configGeometry_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed) :
    cf.map.ConfigGeometry :=
  PointedHypermap.cpmap_configGeometry_of_config hcf

theorem map_plain_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed) :
    cf.map.map.Plain :=
  (map_configGeometry_of_wellFormed hcf).plain

theorem map_connected_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed) :
    cf.map.map.Connected :=
  (map_configGeometry_of_wellFormed hcf).connected

theorem map_bridgeless_of_wellFormed
    {cf : Config}
    (hcf : cf.WellFormed) :
    cf.map.map.Bridgeless :=
  (map_configGeometry_of_wellFormed hcf).bridgeless

